<?xml version="1.0" encoding="utf-8"?>
<mujoco>
	<compiler angle="radian" coordinate="local" meshdir="../stls/fetch" texturedir="../textures"></compiler>
	<option timestep="0.002">
		<flag warmstart="enable"></flag>
	</option>

	<include file="shared.xml"></include>
	<visual>

		<!-- softer background -->
	 	<rgba haze="0.18 0.18 0.2 1"/>

		<!-- shadow quality -->
		<quality shadowsize="2048"/>

		<!-- nicer rendering -->
		<map force="0.1" znear="0.01"/>

	</visual>

	<worldbody>
		<geom name="floor0" pos="0.8 0.75 0" size="0.85 0.7 1" type="plane" condim="3" material="floor_mat"></geom>
		<body name="floor0" pos="0.8 0.75 0">
			<site name="target0" pos="0 0 0.5" size="0.02 0.02 0.02" rgba="1 0 0 0" type="sphere"></site>
		</body>

		<include file="robot.xml"></include>

		<body pos="1.3 0.75 0.2" name="table0">
			<geom size="0.25 0.35 0.2" type="box" mass="2000" material="table_mat"></geom>
		</body>

		<!-- MAIN RL CUBE -->
		<body name="object0" pos="1.30 0.65 0.425">

			<joint
				name="object0:joint"
				type="free"
				damping="0.01"
			/>

			<geom
				name="object0"
				type="box"
				size="0.025 0.025 0.025"
				rgba="0.75 0.08 0.08 1"
				condim="3"
				mass="0.25"
				friction="1 0.005 0.0001"
				solimp="0.95 0.99 0.001"
				solref="0.001 1"
			/>

			<site
				name="object0"
				pos="0 0 0"
				size="0.001"
				rgba="1 0 0 0"
				type="sphere"
			/>

		</body>

		<!-- BLUE CUBE -->
		<body name="blueobj" pos="1.4 0.55 0.425">

			<joint
				name="blueobj:joint"
				type="free"
				damping="0.01"
			/>

			<geom
				name="blueobj"
				type="box"
				size="0.025 0.025 0.025"
				rgba="0.08 0.2 0.75 1"
				condim="3"
				mass="0.25"
				friction="1 0.005 0.0001"
				solimp="0.95 0.99 0.001"
				solref="0.001 1"
			/>

			<site
				name="blueobj_site"
				pos="0 0 0"
				size="0.001"
				rgba="0 0 1 0"
				type="sphere"
			/>

		</body>

		<body name="tray" pos="1.3 0.75 0.4">

			<!-- Bottom plate -->
			<geom
				name="tray_bottom"
				type="box"
				size="0.12 0.12 0.005"
				rgba="0.18 0.18 0.2 1"/>

			<!-- Left wall -->
			<geom
				name="tray_left"
				type="box"
				pos="-0.115 0 0.025"
				size="0.005 0.12 0.025"
				rgba="0.24 0.24 0.26 1"/>

			<!-- Right wall -->
			<geom
				name="tray_right"
				type="box"
				pos="0.115 0 0.025"
				size="0.005 0.12 0.025"
				rgba="0.24 0.24 0.26 1"/>

			<!-- Front wall --> 
			<geom
				name="tray_front"
				type="box"
				pos="0 0.115 0.025"
				size="0.12 0.005 0.025"
				rgba="0.24 0.24 0.26 1"/>


			<geom
				name="tray_back"
				type="box"
				pos="0 -0.115 0.025"
				size="0.12 0.005 0.025"
				rgba="0.24 0.24 0.26 1"/>

		</body>

		<camera
			name="top_cam"
			pos="1.3 0.75 1.2"
			euler="0 0 1.57"
			fovy="90"
		/>

		<light
			name="light0"
			pos="1.5 0.5 2.5"
			dir="-0.3 0 -1"
			directional="true"
			castshadow="false"
			ambient="0.35 0.35 0.35"
			diffuse="0.6 0.6 0.6"
			specular="0.08 0.08 0.08"/>
		
	</worldbody>

	<actuator>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:l_gripper_finger_joint" kp="30000" name="robot0:l_gripper_finger_joint" user="1"></position>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:r_gripper_finger_joint" kp="30000" name="robot0:r_gripper_finger_joint" user="1"></position>
	</actuator>
</mujoco>
